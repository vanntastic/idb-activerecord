# Turso credentials for the Turso Sync demo.
# Copy this file to `.env` and fill in your own values.
#
#   cp examples/turso-sync/.env.example examples/turso-sync/.env
#
# Create a database + token at https://turso.tech/

TURSO_DATABASE_URL=libsql://your-turso-db-url
TURSO_AUTH_TOKEN=your-turso-auth-token

# Optional — port the proxy server listens on (default 3002).
# PORT=3002
